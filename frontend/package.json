{
  "name": "deloitte-juca",
  "type": "module",
  "version": "1.0.10",
  "private": true,
  "description": "Sistema de Recuperação Financeira - Deloitte",
  "scripts": {
    "dev": "vite --mode devremote",
    "dev:local": "vite --mode devlocal",
    "build:prod": "vue-tsc && vite build --mode production --base=/juca/static/src/vue/dist/ --emptyOutDir",
    "build:hml": "vue-tsc && vite build --mode homolog --base=/juca/static/src/vue/dist/ --emptyOutDir",
    "test": "vitest --ui --mode devremote",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@formkit/auto-animate": "1.0.0-beta.6",
    "@jrnwn/utils": "^0.0.2",
    "@quasar/extras": "^1.16.4",
    "@unocss/reset": "^0.49.8",
    "@vueuse/core": "^9.13.0",
    "animol": "^1.0.12",
    "axios": "^1.4.0",
    "quasar": "^2.12.2",
    "vue": "^3.3.4",
    "vue-router": "^4.2.2"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^0.35.3",
    "@iconify-json/carbon": "^1.1.18",
    "@quasar/vite-plugin": "^1.4.1",
    "@types/node": "^18.16.19",
    "@unocss/preset-icons": "^0.49.8",
    "@vitejs/plugin-vue": "^4.2.3",
    "@vitest/ui": "^0.30.1",
    "eslint": "^8.44.0",
    "jsdom": "^22.1.0",
    "sass": "1.32.12",
    "typescript": "^4.9.5",
    "unocss": "^0.49.8",
    "unplugin-auto-import": "^0.14.4",
    "unplugin-vue-components": "^0.23.0",
    "vite": "^4.3.9",
    "vite-plugin-mkcert": "^1.16.0",
    "vite-plugin-pages": "^0.28.0",
    "vite-plugin-vue-layouts": "^0.8.0",
    "vitest": "^0.30.1",
    "vue-tsc": "^1.8.3"
  }
}
